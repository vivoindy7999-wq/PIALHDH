local timeStopActive = false
local TimeStopBtn = AddButton(Tab2, "⏱️ หยุดเวลา (Time Stop: ปิด)", function()
    timeStopActive = not timeStopActive
    if timeStopActive then
        TimeStopBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0) -- สีเขียวเมื่อเปิด
        TimeStopBtn.Text = "⏱️ หยุดเวลา (Time Stop: เปิด)"
    else
        TimeStopBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0) -- สีแดงเมื่อปิด
        TimeStopBtn.Text = "⏱️ หยุดเวลา (Time Stop: ปิด)"
        
        -- คืนค่าให้ผู้เล่นคนอื่นขยับได้ทันทีเมื่อปิด
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hrp then hrp.Anchored = false end
                if hum then hum.WalkSpeed = 16 end
            end
        end
    end
end)
TimeStopBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)

RunService.Heartbeat:Connect(function()
    if timeStopActive then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hrp then hrp.Anchored = true end
                if hum then hum.WalkSpeed = 0 end
            end
        end
    end
end)

